# Copy this file to .env for local development (never commit the real .env)

# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# Leave DATABASE_URL unset to use local SQLite (instance/crm_erp.db).
# For Neon / any managed Postgres, paste the connection string here:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
